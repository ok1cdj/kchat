<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome kChat launcher: black speech-bubble outline enclosing a "k".
     Foreground for the adaptive icon (white background); also the monochrome
     layer. Pure black on transparent for the 1-bit e-ink launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- speech bubble outline with a bottom-left tail -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,30 L70,30 Q82,30 82,42 L82,54 Q82,66 70,66 L50,66 L34,80 L44,66 L38,66 Q26,66 26,54 L26,42 Q26,30 38,30 Z" />

    <!-- letter k -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M46,40 L46,58 M58,45 L49,50 L59,60" />
</vector>
